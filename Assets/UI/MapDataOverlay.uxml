                <ui:Instance template="ScanDataOverlay" name="ScanDataOverlay" style="flex-grow: 1; font-size: 55px; color: rgb(255, 255, 255); display: flex; justify-content: flex-start; align-items: stretch; align-self: auto; position: relative;" />
