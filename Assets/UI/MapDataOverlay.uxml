        <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" name="ScanDataScrollView" tabindex="0" touch-scroll-type="Elastic" style="display: flex; visibility: visible; overflow: visible; position: relative; right: auto; bottom: auto; top: auto; opacity: 1; flex-shrink: 1; width: auto; flex-direction: column; flex-basis: auto; align-self: auto; flex-grow: 1; align-items: stretch; flex-wrap: nowrap;">
