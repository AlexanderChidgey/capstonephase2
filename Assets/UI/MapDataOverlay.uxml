        <ui:Instance template="BottomNavBar" name="BottomNavBar" style="position: absolute; bottom: 0; left: 0; right: 0; top: auto;" />
        <ui:VisualElement name="SafeScreenPadding" style="flex-grow: 0; align-items: auto; flex-direction: column; background-color: rgb(53, 124, 131); bottom: auto; width: auto; height: auto; flex-basis: 0;" />
